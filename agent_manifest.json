{
  "agent_name": "RxGuardian AI",
  "description": "Multi-agent healthcare medication safety copilot",
  "version": "1.0",
  "agents": [
    {
      "name": "Safety Agent",
      "role": "Detects medication risks and severity"
    },
    {
